# Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values
# IMPORTANT: Never commit .env.local to git - it contains sensitive credentials

# ==========================================
# API Configuration
# ==========================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000
EXPO_PUBLIC_API_TIMEOUT=30000

# ==========================================
# Firebase Configuration (for Phone Authentication)
# Get these values from Firebase Console -> Project Settings
# ==========================================
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id

# ==========================================
# App Configuration
# ==========================================
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# ==========================================
# Feature Flags
# ==========================================
EXPO_PUBLIC_ENABLE_DEBUG=true
EXPO_PUBLIC_EXPO_GO_OTP_MODE=true
EXPO_PUBLIC_EXPO_DEV_OTP=123456
