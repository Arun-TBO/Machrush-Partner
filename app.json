{
  "expo": {
    "name": "macrush-mobile",
    "slug": "macrush-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/DriverAppIcon.png",
    "scheme": "macrushmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.machrush.driver",
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#eff2f6",
     "adaptiveIcon": {
      "foregroundImage": "./assets/images/DriverAppIcon.png",
          "backgroundColor": "#1157C8"
    },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Machrush to show your current area and district on the home screen."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/DriverAppIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
